// Ресурс версии (#63), создаётся из cmake/version.rc.in для @APPROUTE_RC_FILENAME@.
#pragma code_page(65001)
#include <winver.h>
#include "AppRouteVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APPROUTE_VERSION_MAJOR,APPROUTE_VERSION_MINOR,APPROUTE_VERSION_PATCH,0
 PRODUCTVERSION APPROUTE_VERSION_MAJOR,APPROUTE_VERSION_MINOR,APPROUTE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @APPROUTE_RC_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "AppRoute"
            VALUE "FileDescription", "@APPROUTE_RC_DESCRIPTION@"
            VALUE "FileVersion", APPROUTE_VERSION_A
            VALUE "InternalName", "@APPROUTE_RC_NAME@"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "@APPROUTE_RC_FILENAME@"
            VALUE "ProductName", "AppRoute"
            VALUE "ProductVersion", APPROUTE_BUILD_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
