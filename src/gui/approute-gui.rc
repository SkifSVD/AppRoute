// Ресурсы approute-gui. Текст в UTF-8.
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

IDI_APP ICON "../../resources/approute.ico"

// Главное окно: размеры и положение кнопок пересчитываются в WM_SIZE
IDD_MAIN DIALOGEX 0, 0, 470, 260
STYLE DS_SHELLFONT | DS_CENTER | WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN
CAPTION "AppRoute — правила программ"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Весь &трафик через:", IDC_PRIMARY_LABEL, 7, 9, 70, 9
    COMBOBOX        IDC_PRIMARY, 80, 7, 200, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Запустить &менеджер маршрутов…", IDC_MANAGER, 286, 6, 120, 14
    LTEXT           "", IDC_PRIMARY_STATE, 7, 23, 456, 18, SS_NOPREFIX
    CONTROL         "", IDC_RULES, WC_LISTVIEW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 7, 396, 200
    PUSHBUTTON      "&Добавить…", IDC_ADD, 410, 7, 53, 14
    PUSHBUTTON      "&Изменить…", IDC_EDIT, 410, 25, 53, 14
    PUSHBUTTON      "&Удалить", IDC_REMOVE, 410, 43, 53, 14
    PUSHBUTTON      "&Запустить", IDC_LAUNCH, 410, 67, 53, 14
    PUSHBUTTON      "&Ярлык…", IDC_SHORTCUT, 410, 85, 53, 14
    PUSHBUTTON      "&Обновить", IDC_REFRESH, 410, 109, 53, 14
    LTEXT           "", IDC_STATUS, 7, 213, 456, 10, SS_ENDELLIPSIS | SS_NOPREFIX
END

IDD_RULE DIALOGEX 0, 0, 330, 186
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Правило"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Программа (полный путь или имя файла):", IDC_LABEL_APP, 7, 7, 316, 9
    EDITTEXT        IDC_APP, 7, 18, 258, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Обзор…", IDC_BROWSE, 270, 17, 53, 14

    LTEXT           "&Интерфейс или прокси:", IDC_LABEL_ADAPTER, 7, 39, 316, 9
    COMBOBOX        IDC_ADAPTER, 7, 50, 316, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ADAPTER_INFO, 7, 66, 316, 9, SS_ENDELLIPSIS | SS_NOPREFIX

    LTEXT           "&Если интерфейс недоступен:", IDC_LABEL_ONUNAVAIL, 7, 83, 130, 9
    COMBOBOX        IDC_ONUNAVAIL, 140, 81, 183, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&DNS программы:", IDC_LABEL_DNS, 7, 101, 130, 9
    COMBOBOX        IDC_DNS, 140, 99, 183, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "IPv&6, если у интерфейса его нет:", IDC_LABEL_IPV6, 7, 119, 130, 9
    COMBOBOX        IDC_IPV6, 140, 117, 183, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Применять к &дочерним процессам", IDC_CHILDREN, 7, 137, 316, 10

    DEFPUSHBUTTON   "OK", IDOK, 216, 165, 50, 14
    PUSHBUTTON      "Отмена", IDCANCEL, 273, 165, 50, 14
END

// Мастер «Новое правило» (Aero Wizard): шаг 1 — программа
IDD_WIZ_APP DIALOGEX 0, 0, 310, 170
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_WAPP_SEARCH, 0, 0, 310, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_WAPP_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_SHAREIMAGELISTS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 17, 310, 112
    LTEXT           "", IDC_WAPP_CHOSEN, 0, 133, 310, 9, SS_PATHELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "&Указать файл или ярлык…", IDC_WAPP_BROWSE, 0, 150, 112, 14
    LTEXT           "если программы нет в списке", IDC_WAPP_HINT, 118, 153, 192, 9
END

// Шаг 2 — интерфейс
IDD_WIZ_ADAPTER DIALOGEX 0, 0, 310, 170
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Программа будет выходить в сеть только через выбранный интерфейс или прокси, остальные программы — как обычно.", IDC_WIF_HINT, 0, 0, 310, 18
    CONTROL         "", IDC_WIF_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 21, 310, 128
    LTEXT           "", IDC_WIF_INFO, 0, 153, 310, 9, SS_ENDELLIPSIS | SS_NOPREFIX
END

// Шаг 3 — если интерфейс недоступен
IDD_WIZ_POLICY DIALOGEX 0, 0, 310, 170
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Переключатели подряд: подпись (LTEXT, WS_GROUP) между ними разорвала бы группу
    AUTORADIOBUTTON "&Блокировать", IDC_WPOL_BLOCK, 0, 0, 310, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Пустить &обычным маршрутом", IDC_WPOL_DEFAULT, 0, 38, 310, 10
    LTEXT           "Пока интерфейс не подключён, программа остаётся без сети. Её трафик никогда не уйдёт через другое подключение.", IDC_WPOL_BLOCK_TEXT, 12, 12, 298, 18
    LTEXT           "Пока интерфейс не подключён, программа работает как без AppRoute. Когда он появится, новые соединения пойдут через него.", IDC_WPOL_DEFAULT_TEXT, 12, 50, 298, 18
    LTEXT           "", IDC_WPOL_SUMMARY, 0, 84, 310, 28, SS_NOPREFIX
    LTEXT           "DNS, IPv6 и дочерние процессы получат настройки по умолчанию; поменять их можно потом кнопкой «Изменить…».", IDC_WPOL_MORE, 0, 146, 310, 18
END

// Адрес SOCKS5-прокси (#17)
IDD_PROXY DIALOGEX 0, 0, 260, 96
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SOCKS5-прокси"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Адрес и порт прокси, например 127.0.0.1:10808 — локальный прокси клиента Xray/V2Ray. Нужен IP-адрес; прокси — без пароля.", IDC_PROXY_HINT, 7, 7, 246, 27
    EDITTEXT        IDC_PROXY_ADDRESS, 7, 38, 246, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_PROXY_STATE, 7, 56, 246, 9, SS_ENDELLIPSIS | SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 146, 75, 50, 14
    PUSHBUTTON      "Отмена", IDCANCEL, 203, 75, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "AppRoute"
            VALUE "FileDescription", "AppRoute — маршрутизация по приложениям"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "approute-gui"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "approute-gui.exe"
            VALUE "ProductName", "AppRoute"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
